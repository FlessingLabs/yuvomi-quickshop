# FlessingLabs QuickShop - gemeinsamer Eingang fuer Yuvomi und den QuickShop-Dienst.
#
# Der Browser muss beide unter DERSELBEN Adresse erreichen (Session-Cookie,
# Same-Origin). Alles unter /api/extensions/flessinglabs-quickshop/ geht an den
# Sidecar, alles andere unveraendert an Yuvomi.
#
# Reines HTTP auf Port 80 im Container (wie Yuvomi direkt). Fuer HTTPS mit
# eigener Domain die erste Zeile durch den Hostnamen ersetzen, z. B.
#   yuvomi.example.org {
# Caddy holt dann selbst ein Zertifikat.

:80 {
	handle /api/extensions/flessinglabs-quickshop/* {
		reverse_proxy quickshop:8080
	}
	handle {
		reverse_proxy yuvomi:3000
	}
}
