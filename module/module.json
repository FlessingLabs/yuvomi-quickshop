{
  "manifestVersion": 1,
  "id": "flessinglabs-quickshop",
  "name": "FlessingLabs QuickShop",
  "version": "2.0.0",
  "description": "Artikelkatalog für die Einkaufsliste: Artikel einmal anlegen, mit einem Tipp auf die Liste setzen. Version 2 braucht Yuvomi mit Modulspeicher (/api/v1/modules/:id/records).",
  "entry": "index.js",
  "style": "style.css",
  "icon": "shopping-basket",
  "accent": "#0F9D8A",
  "i18n": {
    "defaultLocale": "de"
  },
  "menu": {
    "show": true,
    "label": "QuickShop",
    "labelKey": "menu",
    "icon": "shopping-basket",
    "order": 25
  },
  "page": {
    "composition": "reading",
    "width": "content",
    "navigation": "standard",
    "responsive": "standard"
  },
  "capabilities": {
    "permissions": {
      "module": {
        "label": "QuickShop",
        "labelKey": "module",
        "icon": "shopping-basket"
      }
    }
  }
}
